# Copy to .env and fill in. Never commit real keys.
HEATMAP_ENV=dev
HEATMAP_DATABASE_URL=postgresql+psycopg://heatmap:heatmap@localhost:5432/heatmap
# HEATMAP_CONFIG_FILES=config/default.yaml

# Provider keys referenced by config/default.yaml (add as many as configured).
ALCHEMY_KEY_1=
ALCHEMY_KEY_2=
ETHERSCAN_KEY_1=
ETHERSCAN_KEY_2=
COINGECKO_API_KEY=                   # only used with pricing.source: coingecko

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
